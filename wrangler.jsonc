{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tinystudio-io-public",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-29",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "tinystudio.io/*", "zone_name": "tinystudio.io" },
    { "pattern": "www.tinystudio.io/*", "zone_name": "tinystudio.io" },
    { "pattern": "app.tinystudio.io/*", "zone_name": "tinystudio.io" },
    { "pattern": "api.tinystudio.io/*", "zone_name": "tinystudio.io" }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/", "/llms.txt", "/offer.md", "/robots.txt", "/sitemap.xml", "/health"]
  }
}
